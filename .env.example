# Salin jadi .env.local untuk pengembangan, atau isikan satu per satu di panel
# hosting untuk produksi. Berkas ini tidak berisi rahasia apa pun, cuma daftar
# nama variabel beserta bentuk nilainya.
#
# Semuanya opsional dalam arti aplikasinya tetap menyala tanpa itu. Yang mati
# cuma fitur yang bersangkutan, dan matinya dijelaskan di layar, bukan berupa
# error. Jadi isi yang perlu saja, mulai dari atas.
#
# Penjelasan lengkap tiap variabel ada di DEPLOY.md.


# ---------------------------------------------------------------------------
# DIBACA SAAT BUILD
#
# Nilai-nilai ini ikut tertanam ke dalam hasil `next build`. Mengubahnya lalu
# menyalakan ulang server tidak mengubah apa pun: harus build ulang. Build-nya
# berjalan di GitHub Actions, dan isinya diambil dari repository variables,
# bukan secrets, karena tidak ada yang rahasia di bagian ini.
# ---------------------------------------------------------------------------

# Domain tiap situs publik. Dipisah koma kalau lebih dari satu bentuk, dan
# YANG PERTAMA dianggap resmi: itu yang dipakai sebagai alamat canonical di
# metadata, sisanya dianggap alias. Jadi apex dulu, baru www.
#
# Dibiarkan kosong, situsnya tetap hidup di jalurnya masing-masing (/turtle
# dan /eddo) dan tidak ada yang rusak. Itu keadaan sebelum domainnya dibeli.
SITE_DOMAIN_EDDO=eddohomestay.com,www.eddohomestay.com
SITE_DOMAIN_TURTLE=

# Kunci client Midtrans. Berawalan NEXT_PUBLIC_ karena browser yang memakainya
# untuk membuka jendela Snap, jadi nilainya ikut tertanam ke JavaScript yang
# diunduh pengunjung. Itu memang rancangannya dan bukan kebocoran, tapi berarti
# JANGAN PERNAH menaruh kunci server di variabel berawalan NEXT_PUBLIC_.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Foto panel login dashboard. Kosong, panelnya tampil sebagai bingkai kosong.
NEXT_PUBLIC_LOGIN_HERO=


# ---------------------------------------------------------------------------
# DIBACA SAAT JALAN
#
# Ini yang benar-benar rahasia. Tidak pernah ikut ke hasil build, tidak pernah
# sampai ke browser, dan tempatnya di panel server, bukan di repositori.
# ---------------------------------------------------------------------------

# Midtrans. Kunci server yang menandatangani permintaan Snap dan yang dipakai
# memeriksa tanda tangan notifikasi. Harus sepasang dengan kunci client di
# atas dan dari lingkungan yang sama: kunci sandbox dengan IS_PRODUCTION=true
# ditolak Midtrans, bukan gagal diam-diam.
#
# Satu pasang kunci melayani dua homestay: notifikasi diarahkan ke inbox yang
# benar lewat awalan order id. Catatan untuk Turtle: halamannya di-prerender,
# jadi kunci ini dibaca saat build untuk memutuskan apakah tombol bayarnya
# digambar sama sekali — mengisinya baru terlihat setelah deploy berikutnya.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Pengiriman email untuk formulir dan pemberitahuan pembayaran. Tanpa ini
# tombol Kirim beralih membuka WhatsApp, jadi tidak ada pesan yang hilang.
RESEND_API_KEY=
ENQUIRY_FROM=

# CMS di tab Website. Tidak ada database, jadi simpanan ditulis sebagai commit
# ke repositori lewat GitHub API. Tokennya fine-grained, izin Contents read
# and write, khusus repositori ini saja.
GITHUB_TOKEN=
GITHUB_REPO=yudventure/unmehopamanagement
GITHUB_BRANCH=main

# Ditanyakan sebelum CMS mau menyimpan. Dibiarkan kosong, endpoint-nya menolak
# jalan sama sekali: kata sandi yang tidak diisi tidak boleh berarti "bebas
# masuk".
CMS_PASSWORD=

# Kata sandi masuk ke dashboard booking. Diperiksa di server, bukan di browser.
# Dibiarkan kosong berarti tidak ada yang bisa masuk sama sekali, arah yang sama
# dengan CMS_PASSWORD: kata sandi yang belum diisi tidak boleh berarti pintu
# yang tidak dikunci.
DASHBOARD_PASSWORD=

# Menandatangani cookie sesi dashboard. Kosong berarti dibuatkan acak tiap
# server menyala, jadi semua orang keluar sendiri setiap restart. Merepotkan
# dan aman, bukan nyaman dan bisa ditebak.
SESSION_SECRET=

# Membuka situs yang sedang ditutup untuk dikerjakan, buat developer. Isi
# dengan teks apa pun yang sulit ditebak, lalu buka
# https://<domain>/preview?token=<isinya> sekali di tiap perangkat.
# Dibiarkan kosong berarti tidak ada jalan masuk sama sekali, dan itu memang
# arahnya: token yang tidak diisi tidak boleh berarti "semua orang boleh
# melihat", karena gagalnya diam dan tampak persis seperti situs yang bekerja.
PREVIEW_TOKEN=

# Sumber kurs, opsional. Kosong berarti memakai open.er-api.com yang tidak
# butuh akun. Kalau jaringan server memblokir sumbernya, harga tampil dalam
# rupiah saja dan tidak ada yang rusak selain itu.
RATES_URL=

# Database booking. Postgres, dan harus Postgres: proteksi anti-double-booking
# di skema ini memakai EXCLUDE USING gist, yang tidak punya padanan di MySQL.
# Tanpa itu, dua permintaan yang datang bersamaan bisa menjual kamar yang sama
# dua kali dan tidak ada yang menahannya selain nasib baik.
#
# Dibiarkan kosong, aplikasinya tetap menyala dan tetap memakai data seed di
# memori, persis seperti sebelum database ada. Tidak ada yang rusak, yang
# hilang cuma keawetannya.
#
# Alamatnya dari Neon: Dashboard -> Connection string -> pilih yang "pooled".
# Yang pooled untuk aplikasi, karena tiap permintaan membuka koneksi sendiri
# dan Postgres punya batas jumlah koneksi. Migrasi butuh yang langsung, lihat
# DIRECT_URL di bawah.
#
# Wajib berakhiran ?sslmode=require. Tanpa itu koneksi ke Neon ditolak.
DATABASE_URL=

# Alamat langsung, tanpa pooler, khusus untuk `prisma migrate`. Migrasi
# mengambil kunci tingkat sesi yang tidak selamat melewati pooler transaksi.
# Di Neon ini connection string yang sama tanpa `-pooler` pada namanya.
DIRECT_URL=
